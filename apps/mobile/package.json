{
  "name": "@budget-builder/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",

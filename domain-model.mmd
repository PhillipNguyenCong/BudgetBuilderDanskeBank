classDiagram
    direction TB

    class User {
        name
    }
    class Budget {
        name
        monthlySalary
    }
    class Account {
        balance
    }
    class Subaccount {
        <<abstract>>
        name
        monthlyAllocation
    }
    class SavingsSubaccount {
        savedAmount
    }
    class SpendingSubaccount {
        carriedIn
        rolloverPreference
        remainingThisMonth()
        weeklyAllowance()
    }
    class FixedExpenseSubaccount {
        reservedAmount
    }
    class RolloverPreference {
        <<enumeration>>
        TO_SAVINGS
        TO_NEXT_MONTH
    }
    class MonthlyRollover {
        month
        amount
    }
    class Transaction {
        date
        amount
        type
    }
    class Forecast {
        period
        expectedBalance
        warning
    }

    User "1" -- "0..*" Budget : owns
    Budget "0..1" -- "1" Account : uses
    Account "1" *-- "1..*" Subaccount : divided into
    Subaccount <|-- SavingsSubaccount
    Subaccount <|-- SpendingSubaccount
    Subaccount <|-- FixedExpenseSubaccount
    SpendingSubaccount --> RolloverPreference : follows
    SpendingSubaccount "0..*" --> "0..1" SavingsSubaccount : savings target
    SpendingSubaccount "1" -- "0..*" MonthlyRollover : source
    MonthlyRollover "0..*" --> "1" Subaccount : destination
    Account "1" -- "0..*" Transaction : records
    Subaccount "0..1" -- "0..*" Transaction : assigned to
    Budget "1" -- "0..*" Forecast : has

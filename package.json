{
  "name": "budget-builder-danske-bank",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/budget-core",
    "apps/backend",
    "apps/mobile"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace @budget-builder/backend",
    "test": "npm run build && node scripts/test.mjs",
    "typecheck": "npm run build && npm run typecheck --workspaces",
    "build": "npm run build --workspace @budget-builder/contracts && npm run build --workspace @budget-builder/budget-core && npm run build --workspace @budget-builder/backend",
    "check:db": "npm run check:db --workspace @budget-builder/backend",
    "docs:api": "npm run build && node apps/backend/dist/openapi.js",
    "migrations:generate": "npm exec --workspace @budget-builder/backend -- drizzle-kit generate --config ../../database/drizzle.config.ts",
    "migrations:apply": "node --env-file-if-exists=apps/backend/.env --import tsx apps/backend/scripts/migrate.ts",
    "check:contracts": "npm run build && node apps/backend/dist/openapi.js --check",
    "format:check": "prettier --check \"apps/backend/**/*.ts\" \"packages/*/src/**/*.ts\" \"database/drizzle.config.ts\" \"scripts/*.mjs\" \"apps/mobile/src/**/*.{ts,tsx}\"",
    "dev:mobile": "npm run build --workspace @budget-builder/contracts && npm run build --workspace @budget-builder/budget-core && npm run start --workspace @budget-builder/mobile",
    "test:mobile": "npm run test --workspace @budget-builder/mobile",
    "test:mobile:api": "npm run build && node --import tsx --test scripts/mobile-creation.test.mjs",
    "typecheck:mobile": "npm run typecheck --workspace @budget-builder/mobile",
    "bundle:mobile:ios": "npm run bundle:ios --workspace @budget-builder/mobile",
    "bundle:mobile:android": "npm run bundle:android --workspace @budget-builder/mobile",
    "check:mobile": "npm run check --workspace @budget-builder/mobile",
    "dev:backend:lan": "HOST=0.0.0.0 npm run dev:backend"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "19.3.0"
  }
}
